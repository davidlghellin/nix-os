#!/usr/bin/env bash
set -euo pipefail

# Busca en TRES sitios:
#   - /etc/wallpapers  → los de assets/ que instala modules/desktop.nix; los ve
#                        cualquier usuario del equipo aunque no tenga el repo
#   - assets/ del repo → mismo contenido, pero si estás trabajando en él
#   - ~/Images         → los que dejas a mano, fuera de git
# Antes solo miraba ~/Images, que en una instalación nueva está vacío
# (systemd.tmpfiles crea el directorio, no su contenido) y el selector
# no ofrecía nada.
WALL_DIRS=( /etc/wallpapers "$HOME/nix-os/assets" "$HOME/Images" )

shopt -s nullglob
declare -a rutas=()
declare -A vistos=()
for d in "${WALL_DIRS[@]}"; do
  [ -d "$d" ] || continue
  for f in "$d"/*.jpg "$d"/*.png "$d"/*.jpeg "$d"/*.webp; do
    # Sin esto, /etc/wallpapers y assets/ del repo (mismo contenido) saldrían
    # duplicados en el menú. Gana el primer directorio de la lista.
    nombre="$(basename "$f")"
    [ -n "${vistos[$nombre]:-}" ] && continue
    vistos[$nombre]=1
    rutas+=( "$f" )
  done
done
shopt -u nullglob

[ ${#rutas[@]} -gt 0 ] || { echo "No hay imágenes en: ${WALL_DIRS[*]}"; exit 0; }

# Se muestra el nombre pero se resuelve la ruta completa, porque puede haber
# ficheros con el mismo nombre en ambos directorios.
SELECTED="$(
  for r in "${rutas[@]}"; do
    printf "%s\0icon\x1f%s\n" "$(basename "$r")" "$r"
  done | rofi -dmenu -p "Wallpaper"
)"

if [ -n "${SELECTED:-}" ]; then
  img=""
  for r in "${rutas[@]}"; do
    [ "$(basename "$r")" = "$SELECTED" ] && { img="$r"; break; }
  done
  [ -n "$img" ] || { echo "No encuentro: $SELECTED"; exit 1; }

  # 1) Wallpaper
  awww img "$img" --transition-fps 60 --transition-step 255 --transition-type any

  # 2) Paleta (pywal) — DESACTIVADO: recalculaba los colores a partir del
  # wallpaper y te cambiaba los de la terminal en cada cambio de fondo.
  # wal -i "$img"

  # 3) Guardar selección (persistencia)
  echo "$img" > "$HOME/.cache/current_wallpaper"
fi
