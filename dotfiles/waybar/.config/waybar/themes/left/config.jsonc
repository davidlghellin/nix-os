{
  "layer": "top",
  "position": "left",
  "exclusive": true,

  "margin-top": 1,
  "margin-bottom": 1,
  "margin-left": 2,
  "margin-right": 0,

  "width": 10,

  "include": [
    "~/.config/waybar/modules.json",
    "~/.config/waybar/custom-modules.json"
  ],

  "modules-left": [
    "custom/appmenu",
    "custom/containers",
    "custom/mic",
    "custom/cam"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "backlight",
    "pulseaudio",
    "battery",
    "tray",
"custom/notifications",
    "clock",
    "custom/lock",
    "custom/exit"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "enable-bar-scroll": true,
    "smooth-scrolling-threshold": 1,

    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",

    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    }
  },

  "tray": {
    "spacing": 3
  },


// Hora APILADA (hora arriba, minutos abajo) a propósito: en una barra vertical
// el ancho lo fija el módulo más ancho, y "{:%H:%M}" en horizontal ensanchaba
// la barra a 46px, espacio que Hyprland reserva y le quita a las ventanas.
// El CSS del tema ya traía clases .hour/.minute pensadas para esto.
"clock": {
  "interval": 1,
  "format": "{:%H\n%M}",
  "format-alt": "{:%d\n%m}",
  "tooltip-format": "{:%Y-%m-%d %H:%M}"
},


  "backlight": {
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"]
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "󱐥",
    "format-plugged": "󱐥",
    // Enchufado y al 100% el kernel reporta "Full" (no "Charging"), y sin
    // format-full waybar caía en "format" y mostraba la batería llena en vez
    // del enchufe. "Full" solo ocurre con el cargador puesto: al desenchufar
    // pasa a "Discharging".
    "format-full": "󱐥",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-bluetooth": "{icon}",
    "format-bluetooth-muted": "󰝟",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "蓼",
      "headset": "蓼",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰕾", "󰕾"]
    },
    "on-click": "pactl set-sink-mute 0 toggle",
    "on-click-right": "pactl set-sink-mute 0 toggle"
  },
  "custom/notifications": {
    "format": "{}",
    "exec": "bash -lc '[[ \"$(swaync-client -D 2>/dev/null)\" == \"true\" ]] && echo \"🔕\" || echo \"🔔\"'",
    "interval": 1,
    "tooltip": false,
    "on-click": "swaync-client -d > /dev/null",
    "on-click-right": "swaync-client -t"
  }
}
